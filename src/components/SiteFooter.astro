---
import Container from './Container.astro';
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
const emailHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent(siteConfig.emailSubject)}`;
const links = [
  { label: 'Produtos', href: '/produtos/' },
  { label: 'Sobre', href: '/sobre/' },
  { label: 'Notas', href: '/notas/' },
  { label: 'Contato', href: '/contato/' },
  { label: 'Política', href: '/privacidade/' },
  { label: 'Termos', href: '/termos/' },
] as const;
const externalLinks = [
  siteConfig.github ? { label: 'GitHub', href: siteConfig.github } : null,
  siteConfig.linkedin ? { label: 'LinkedIn', href: siteConfig.linkedin } : null,
].filter((link) => link !== null);
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/"><span>WR</span> Labs</a>
        <p>{siteConfig.tagline}</p>
      </div>
      <nav aria-label="Navegação do rodapé">
        <ul>{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
      <div class="site-footer__contact">
        {externalLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
        <a href={emailHref}>{siteConfig.email}</a>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>© {currentYear} {siteConfig.name}</p>
      <p>Produtos digitais construídos com atenção.</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 7vw, 5rem) var(--space-5);
    background: var(--dark-section);
    color: var(--dark-text);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-7);
  }

  .site-footer__brand > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    color: var(--dark-text);
    font-size: 1.1rem;
    font-weight: 750;
    text-decoration: none;
  }

  .site-footer__brand > a span {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 0.7rem;
    background: var(--dark-section-soft);
    font-size: 0.65rem;
    letter-spacing: -0.06em;
  }

  .site-footer__brand p {
    max-width: 19rem;
    margin: var(--space-3) 0 0;
    color: var(--dark-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .site-footer__contact a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--dark-muted);
    font-size: var(--font-caption);
    text-decoration-color: rgb(255 255 255 / 25%);
  }

  .site-footer__contact {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(255 255 255 / 12%);
    color: var(--dark-muted);
    font-size: var(--font-label);
  }

  .site-footer__bottom p { margin: 0; }

  @media (min-width: 52rem) {
    .site-footer__top { grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1fr) auto; }
  }

  @media (hover: hover) {
    nav a:hover,
    .site-footer__contact a:hover { color: var(--dark-text); }
  }
</style>
