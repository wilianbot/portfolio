---
export const techIconNames = [
  'code', 'architecture', 'api', 'database', 'cache', 'queue', 'container',
  'cloud', 'frontend', 'backend', 'mobile', 'product', 'study', 'experience',
] as const;

export type TechIconName = (typeof techIconNames)[number];

interface Props {
  name: TechIconName;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
const paths: Record<TechIconName, string[]> = {
  code: ['m8 9-3 3 3 3', 'm16 9 3 3-3 3', 'm14 5-4 14'],
  architecture: ['M12 3v4', 'M5 10h14', 'M5 10v4', 'M12 10v4', 'M19 10v4', 'M3 14h4v5H3z', 'M10 14h4v5h-4z', 'M17 14h4v5h-4z'],
  api: ['M7 7h10v10H7z', 'M3 12h4', 'M17 12h4', 'M12 3v4', 'M12 17v4'],
  database: ['M5 6c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3Z', 'M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6', 'M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6'],
  cache: ['M5 7h14v10H5z', 'm8 10 3-3 3 3', 'm3 7 3-3 3 3'],
  queue: ['M5 6h14', 'M5 12h10', 'M5 18h6', 'm16 9 3 3-3 3'],
  container: ['M4 7h16v11H4z', 'M8 7V4h8v3', 'M8 11h8', 'M8 15h8'],
  cloud: ['M7 18h10a4 4 0 0 0 .6-8A6 6 0 0 0 6.2 9.5 4.5 4.5 0 0 0 7 18Z'],
  frontend: ['M4 5h16v14H4z', 'M4 9h16', 'M7 7h.01', 'M10 7h.01'],
  backend: ['M6 5h12v5H6z', 'M6 14h12v5H6z', 'M9 7.5h.01', 'M9 16.5h.01'],
  mobile: ['M8 3h8v18H8z', 'M11 6h2', 'M11 18h2'],
  product: ['M4 8 12 3l8 5-8 5z', 'M4 8v8l8 5 8-5V8', 'M12 13v8'],
  study: ['M4 6h11a3 3 0 0 1 3 3v9H7a3 3 0 0 0-3 3Z', 'M7 9h7', 'M7 13h7'],
  experience: ['M8 7V5h8v2', 'M4 8h16v11H4z', 'M4 12h16', 'M10 12v2h4v-2'],
};
---

<svg
  class="tech-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
>
  {label && <title>{label}</title>}
  {paths[name].map((path) => <path d={path} />)}
</svg>

<style>.tech-icon { display: block; flex: none; }</style>
