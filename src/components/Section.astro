---
interface Props {
  id?: string;
  labelledby?: string;
  tone?: 'default' | 'subtle';
  class?: string;
}

const { id, labelledby, tone = 'default', class: className } = Astro.props;
---

<section
  {id}
  class:list={['section', `section--${tone}`, className]}
  aria-labelledby={labelledby}
>
  <slot />
</section>

<style>
  .section {
    padding-block: var(--space-section);
  }

  .section--subtle {
    background: var(--color-surface-subtle);
    border-block: var(--border-thin);
  }
</style>
