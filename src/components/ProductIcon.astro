---
interface Props {
  slug: string;
  size?: 'medium' | 'large';
  class?: string;
}

const { slug, size = 'medium', class: className } = Astro.props;
const supportedSlug = [
  'prontodoc',
  'gestoriza',
  'chronos',
  'observatorio-legislativo',
].includes(slug)
  ? slug
  : 'default';
---

<span
  class:list={['product-icon', `product-icon--${supportedSlug}`, `product-icon--${size}`, className]}
  aria-hidden="true"
>
  {supportedSlug === 'prontodoc' && (
    <svg viewBox="0 0 32 32" fill="none">
      <path d="M9 5.5h9l5 5v16H9z" />
      <path d="M18 5.5v5h5M12.5 16h7M12.5 20.5h7" />
    </svg>
  )}
  {supportedSlug === 'gestoriza' && (
    <svg viewBox="0 0 32 32" fill="none">
      <rect x="5.5" y="8" width="21" height="18" rx="3" />
      <path d="M10.5 5.5v5M21.5 5.5v5M5.5 13h21M10.5 18h4M17.5 18h4M10.5 22h4" />
    </svg>
  )}
  {supportedSlug === 'chronos' && (
    <svg viewBox="0 0 32 32" fill="none">
      <path d="M8 25.5h16M10 22.5h12M11.5 10.5h9v12h-9zM9 8h14L16 4.5z" />
      <path d="M14 13v6M18 13v6" />
    </svg>
  )}
  {supportedSlug === 'observatorio-legislativo' && (
    <svg viewBox="0 0 32 32" fill="none">
      <path d="M5 26.5h22M8 23V13h4v10M14 23V8h4v15M20 23v-7h4v7" />
      <path d="m7 9 7-4 6 2 5-3" />
    </svg>
  )}
  {supportedSlug === 'default' && (
    <svg viewBox="0 0 32 32" fill="none">
      <circle cx="16" cy="16" r="9" />
      <path d="M16 3.5v4M16 24.5v4M3.5 16h4M24.5 16h4" />
    </svg>
  )}
</span>

<style>
  .product-icon {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: var(--radius-medium);
    background: var(--primary-soft);
    color: var(--primary);
  }

  .product-icon--medium {
    width: 3.75rem;
    height: 3.75rem;
  }

  .product-icon--large {
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-large);
  }

  svg {
    width: 52%;
    height: 52%;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .product-icon--gestoriza {
    background: var(--success-soft);
    color: var(--success);
  }

  .product-icon--chronos {
    background: var(--warning-soft);
    color: var(--warning);
  }

  .product-icon--observatorio-legislativo {
    background: var(--info-soft);
    color: var(--info);
  }
</style>
