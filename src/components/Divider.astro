---
interface Props {
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['divider', className]} role={label ? 'separator' : undefined}>
  {label ? <span>{label}</span> : null}
</div>

<style>
  .divider {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .divider::before,
  .divider::after {
    height: 1px;
    flex: 1;
    background: var(--color-border);
    content: '';
  }

  .divider:not(:has(span))::after {
    display: none;
  }
</style>
