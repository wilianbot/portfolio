---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ProductList from '../../components/ProductList.astro';
import { sortProducts, validateProductCollection } from '../../lib/products';

const products = sortProducts(await getCollection('products'));
validateProductCollection(products);
---

<BaseLayout
  title="Produtos — WR Labs"
  description="Produtos, estudos e casos técnicos da WR Labs."
>
  <header class="products-header">
    <Container>
      <div class="products-header__layout">
        <div>
          <Eyebrow>Arquivo de produtos</Eyebrow>
          <h1>Produtos, estudos e construções técnicas.</h1>
        </div>
        <p>
          Uma visão completa do que já faz parte do laboratório, sem presumir
          publicação ou disponibilidade.
        </p>
      </div>
    </Container>
  </header>

  <section class="products-main" aria-labelledby="products-list-title">
    <Container>
      <h2 id="products-list-title" class="visually-hidden">Todos os produtos</h2>
      <ProductList products={products} />
    </Container>
  </section>
</BaseLayout>

<style>
  .products-header {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    background: linear-gradient(145deg, var(--background), var(--primary-soft));
  }

  .products-header__layout {
    display: grid;
    gap: var(--space-5);
  }

  .products-header h1 {
    max-width: 15ch;
    margin-bottom: 0;
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-title);
  }

  .products-header p {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-subtitle);
  }

  .products-main {
    padding-block: var(--space-section);
    background: var(--background-soft);
  }

  @media (min-width: 56rem) {
    .products-header__layout {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.5fr);
      align-items: end;
    }
  }
</style>
