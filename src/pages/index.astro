---
import { getCollection } from 'astro:content';
import AboutSection from '../components/AboutSection.astro';
import ButtonLink from '../components/ButtonLink.astro';
import ContactCallout from '../components/ContactCallout.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductStatus from '../components/ProductStatus.astro';
import TextLink from '../components/TextLink.astro';
import ArchitectureMiniDiagram from '../components/ArchitectureMiniDiagram.astro';
import CodeProfile from '../components/CodeProfile.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import NowPanel from '../components/NowPanel.astro';
import StackLayers from '../components/StackLayers.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  filterFeaturedProducts,
  filterLabActivityProducts,
  formatProductDate,
  sortProducts,
  validateProductCollection,
} from '../lib/products';
import { profile } from '../data/profile';
import { professionalExperiences } from '../data/experience';
import { currentFocus } from '../data/now';
import { skillGroups } from '../data/skills';

const products = sortProducts(await getCollection('products'));
validateProductCollection(products);
const featuredProducts = filterFeaturedProducts(products).slice(0, 4);
const labProducts = filterLabActivityProducts(products, 2);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <Container>
      <div class="hero__grid">
        <div class="hero__content">
          <Eyebrow>WR Labs — Produtos e Engenharia de Software</Eyebrow>
          <h1 id="hero-title">
            <span class="hero__title-line">Construindo <span class="hero__title-accent">produtos digitais</span></span>
            <span class="hero__title-line">e sistemas para problemas reais.</span>
          </h1>
          <p class="hero__description">{profile.homeDescription}</p>
          <div class="hero__actions" role="group" aria-label="Ações principais">
            <ButtonLink href="#produtos">Conhecer os produtos</ButtonLink>
            <ButtonLink href="/sobre/" variant="secondary">Sobre minha jornada</ButtonLink>
          </div>
        </div>
        <div class="hero__visual">
          <CodeProfile />
          <ArchitectureMiniDiagram
            label="Áreas de atuação conectadas: frontend, API, serviços e dados"
            nodes={[{ label: 'Frontend' }, { label: 'API' }, { label: 'Services' }, { label: 'Data' }]}
          />
        </div>
      </div>

      <div class="focus-line">
        <strong>Foco</strong>
        <ul aria-label="Focos da WR Labs">
          <li>Simplicidade</li><li>Performance</li><li>Experiência</li>
        </ul>
      </div>
    </Container>
  </section>

  <section id="produtos" class="products-section" aria-labelledby="produtos-title">
    <Container>
      <div class="section-heading">
        <div>
          <Eyebrow>Produtos</Eyebrow>
          <h2 id="produtos-title">Construindo soluções que fazem a diferença.</h2>
        </div>
        <p>Uma seleção de produtos e experiências desenvolvidas no laboratório.</p>
      </div>
      <div class="featured-products">
        {featuredProducts.map((product, index) => <ProductCard product={product} index={index + 1} />)}
      </div>
      <div class="section-action"><TextLink href="/produtos/" arrow="right">Ver todos os produtos</TextLink></div>
    </Container>
  </section>

  <section class="home-section home-section--subtle" aria-labelledby="experiencia-home-title">
    <Container>
      <div class="section-heading">
        <div><Eyebrow>Experiência · timeline</Eyebrow><h2 id="experiencia-home-title">Sistemas reais, evolução contínua.</h2></div>
        <p>Um resumo da experiência recente em desenvolvimento, integração e dados.</p>
      </div>
      <ExperienceTimeline experiences={professionalExperiences} limit={2} />
      <div class="section-action"><TextLink href="/sobre/#experiencia" arrow="right">Ver trajetória completa</TextLink></div>
    </Container>
  </section>

  <AboutSection />

  <section class="home-section" aria-labelledby="atuacao-title">
    <Container>
      <div class="section-heading">
        <div><Eyebrow>Arquitetura · camadas</Eyebrow><h2 id="atuacao-title">Áreas que trabalho de forma integrada.</h2></div>
        <p>Uma seleção do repertório técnico, organizada pelo papel de cada camada no sistema.</p>
      </div>
      <StackLayers groups={skillGroups.slice(0, 5).map((group) => ({ ...group, items: group.items.slice(0, 4) }))} />
    </Container>
  </section>

  {labProducts.length > 0 && (
    <section class="lab-section" aria-labelledby="laboratorio-title">
      <Container>
        <div class="section-heading">
          <div><Eyebrow>Em movimento</Eyebrow><h2 id="laboratorio-title">Agora no laboratório</h2></div>
        </div>
        <ul class="lab-grid">
          {labProducts.map((product) => {
            const updatedAt = formatProductDate(product.data.ultimaAtualizacao);
            return (
              <li>
                <a href={`/produtos/${product.data.slug}/`}>
                  <strong>{product.data.nome}</strong>
                  <ProductStatus status={product.data.status} />
                  {updatedAt && <time datetime={product.data.ultimaAtualizacao?.toISOString()}>{updatedAt}</time>}
                  <span>Acompanhar →</span>
                </a>
              </li>
            );
          })}
        </ul>
      </Container>
    </section>
  )}

  <section class="home-section home-section--subtle" aria-labelledby="agora-home-title">
    <Container>
      <div class="section-heading">
        <div><Eyebrow>system.now</Eyebrow><h2 id="agora-home-title">Agora.</h2></div>
        <p>Trabalho, estudos e interesses que orientam a evolução profissional neste momento.</p>
      </div>
      <NowPanel
        focus={currentFocus}
        products={labProducts.map((product) => ({ name: product.data.nome, href: `/produtos/${product.data.slug}/` }))}
      />
    </Container>
  </section>

  <ContactCallout />
</BaseLayout>

<style>
  .hero { overflow: hidden; padding-block: clamp(3.5rem, 8vw, 6.5rem) var(--space-6); }
  .hero__grid { display: grid; align-items: center; gap: var(--space-7); }
  .hero__visual { display: grid; gap: var(--space-4); min-width: 0; }
  h1 { max-width: 18ch; margin-bottom: var(--space-5); font-size: var(--font-display); font-weight: 740; letter-spacing: var(--tracking-tight); line-height: var(--leading-display); }
  .hero__title-line { display: block; }
  .hero__title-accent { color: var(--primary); }
  .hero__description { max-width: 38rem; margin-bottom: var(--space-6); color: var(--text-secondary); font-size: clamp(1.05rem, 2vw, 1.2rem); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .focus-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: clamp(2.5rem, 6vw, 4.5rem); padding-top: var(--space-5); border-top: var(--border-thin); font-size: var(--font-caption); }
  .focus-line strong { color: var(--text-primary); font-size: var(--font-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .focus-line ul { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); margin: 0; padding: 0; color: var(--text-secondary); list-style: none; }
  .focus-line li { display: flex; align-items: center; gap: var(--space-5); }
  .focus-line li:not(:last-child)::after { width: 0.25rem; height: 0.25rem; border-radius: 50%; background: var(--primary); content: ''; }
  .products-section, .lab-section, .home-section { padding-block: var(--space-section); }
  .products-section { background: var(--background-soft); }
  .home-section--subtle { background: var(--background-soft); }
  .section-heading { display: grid; gap: var(--space-5); margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .section-heading h2 { max-width: 18ch; margin: 0; font-size: var(--font-title); font-weight: 720; letter-spacing: var(--tracking-tight); line-height: var(--leading-title); }
  .section-heading > p { max-width: 30rem; margin: 0; color: var(--text-secondary); }
  .featured-products { display: grid; gap: var(--space-4); }
  .section-action { display: flex; justify-content: flex-end; padding-top: var(--space-6); }
  .lab-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .lab-grid a { display: flex; align-items: flex-start; flex-direction: column; gap: var(--space-3); min-height: 12rem; padding: var(--space-6); border: var(--border-thin); border-radius: var(--radius-medium); background: var(--surface); color: var(--text-primary); text-decoration: none; box-shadow: var(--shadow-small); }
  .lab-grid time { color: var(--text-muted); font-size: var(--font-caption); }
  .lab-grid a > span:last-child { margin-top: auto; color: var(--primary); font-weight: 700; }

  @media (min-width: 56rem) {
    .hero__grid { grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr); gap: clamp(3rem, 7vw, 7rem); }
    .section-heading { grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.5fr); align-items: end; }
  }

  @media (max-width: 35rem) {
    .hero { padding-top: var(--space-7); }
    h1 { font-size: clamp(2.6rem, 13vw, 3.5rem); }
    .hero__actions > :global(a) { width: 100%; }
    .focus-line { align-items: flex-start; flex-direction: column; }
    .focus-line ul { gap: var(--space-2) var(--space-3); }
    .focus-line li { gap: var(--space-3); }
  }
</style>
