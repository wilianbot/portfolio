---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ButtonLink from '../components/ButtonLink.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ProductLabMark from '../components/ProductLabMark.astro';
import ProductList from '../components/ProductList.astro';
import Section from '../components/Section.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TextLink from '../components/TextLink.astro';
import {
  filterFeaturedProducts,
  filterLabActivityProducts,
  formatProductStatus,
  sortProducts,
  validateProductCollection,
} from '../lib/products';

const products = sortProducts(await getCollection('products'));
validateProductCollection(products);

const featuredProducts = filterFeaturedProducts(products);
const labProducts = filterLabActivityProducts(products, 2);
---

<BaseLayout>
  <SiteHeader />

  <section class="hero" aria-labelledby="hero-title">
    <Container>
      <div class="hero__grid">
        <div class="hero__content">
          <Eyebrow>WR Labs — Product Studio</Eyebrow>
          <h1 id="hero-title">
            Produtos digitais simples,<br /> úteis e bem construídos.
          </h1>
          <p class="hero__description">
            Crio aplicativos, plataformas e ferramentas para resolver problemas
            reais, explorar ideias e transformar aprendizado em produtos.
          </p>
          <div class="hero__actions" aria-label="Ações principais">
            <ButtonLink href="#produtos">Conhecer produtos</ButtonLink>
            <ButtonLink href="/sobre/" variant="secondary">Sobre a WR Labs</ButtonLink>
          </div>
        </div>

        <div class="hero__visual">
          <ProductLabMark />
        </div>
      </div>

      <div class="principles" aria-label="Princípios da WR Labs">
        <span>Simplicidade</span>
        <span>Desempenho</span>
        <span>Experiência</span>
        <span>Evolução</span>
      </div>
    </Container>
  </section>

  <Section id="produtos" labelledby="produtos-title">
    <Container>
      <div class="section-heading">
        <div>
          <Eyebrow>Produtos selecionados</Eyebrow>
          <h2 id="produtos-title">Construções do laboratório.</h2>
        </div>
        <p>
          Uma seleção de aplicativos, plataformas e ferramentas criadas pela WR
          Labs.
        </p>
      </div>

      <ProductList products={featuredProducts} />

      <div class="section-action">
        <TextLink href="/produtos/" arrow="right">Ver todos os produtos</TextLink>
      </div>
    </Container>
  </Section>

  <Section tone="subtle" labelledby="laboratorio-title">
    <Container>
      <div class="lab-section">
        <div>
          <Eyebrow>Em movimento</Eyebrow>
          <h2 id="laboratorio-title">Agora no laboratório</h2>
        </div>

        {labProducts.length > 0 ? (
          <ul class="lab-list">
            {labProducts.map((product) => (
              <li>
                <strong>{product.data.nome}</strong>
                <span>{formatProductStatus(product.data.status)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="lab-empty">
            Os projetos em atividade aparecerão aqui quando o status estiver
            confirmado.
          </p>
        )}
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7.5rem) var(--space-7);
  }

  .hero__grid {
    display: grid;
    align-items: center;
    gap: var(--space-7);
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  h1 {
    max-width: 13ch;
    margin: 0 0 var(--space-6);
    font-size: clamp(2.625rem, 8.5vw, 5.75rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: 0.98;
  }

  .hero__description {
    max-width: 38rem;
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__visual {
    min-width: 0;
  }

  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: var(--space-5);
    border-top: var(--border-thin);
    color: var(--color-text-muted);
    font-size: var(--font-label);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .principles span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-5);
  }

  .principles span:not(:last-child)::after {
    width: 0.1875rem;
    height: 0.1875rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  .section-heading {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .section-heading h2,
  .lab-section h2 {
    max-width: 12ch;
    margin-bottom: 0;
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-title);
  }

  .section-heading > p {
    max-width: 30rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .section-action {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-6);
  }

  .lab-section {
    display: grid;
    gap: var(--space-7);
  }

  .lab-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lab-list li {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--border-thin);
  }

  .lab-list span,
  .lab-empty {
    color: var(--color-text-muted);
    font-size: var(--font-caption);
  }

  .lab-empty {
    max-width: 30rem;
    margin: 0;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.75fr);
      gap: clamp(2rem, 6vw, 6rem);
    }

    .section-heading,
    .lab-section {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
      align-items: end;
    }
  }

  @media (max-width: 35rem) {
    .hero {
      padding-top: var(--space-7);
    }

    h1 {
      font-size: clamp(2.5rem, 13.5vw, 4.25rem);
    }

    h1 br {
      display: none;
    }

    .hero__actions > :global(a) {
      width: 100%;
    }

    .principles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
      letter-spacing: 0.06em;
    }

    .principles span {
      gap: var(--space-3);
    }

    .principles span:not(:last-child)::after {
      order: -1;
    }
  }
</style>
