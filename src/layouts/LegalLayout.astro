---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
}

const { title, description, eyebrow } = Astro.props;
---

<BaseLayout title={`${title} — WR Labs`} {description}>
  <article class="legal-page">
    <header>
      <Container size="reading">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h1>{title}</h1>
        <p>{description}</p>
      </Container>
    </header>

    <div class="legal-content">
      <Container size="reading">
        <slot />
      </Container>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-page > header {
    padding-block: clamp(4rem, 10vw, 7rem);
    border-bottom: var(--border-thin);
  }

  h1 {
    margin-bottom: var(--space-5);
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-title);
  }

  .legal-page > header p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-subtitle);
  }

  .legal-content {
    padding-block: var(--space-section);
  }

  .legal-content :global(section) {
    padding-block: var(--space-6);
    border-top: var(--border-thin);
  }

  .legal-content :global(section:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  .legal-content :global(h2) {
    margin-bottom: var(--space-4);
    font-size: var(--font-subtitle);
  }

  .legal-content :global(p),
  .legal-content :global(li) {
    color: var(--color-text-muted);
  }

  .legal-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .legal-content :global(ul) {
    padding-left: 1.25rem;
  }
</style>
